# Copy to .env. Keep secrets out of Git.
DATABASE_PATH=/data/smart_queue.db
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
AI_TIMEOUT_SECONDS=10
TIMEZONE=America/Puerto_Rico

# Optional Microsoft Teams Workflows plugin (disabled by default).
# Never put the generated webhook URL in source control or a VITE_* variable.
TEAMS_PLUGIN_ENABLED=false
TEAMS_TEAM_NAME=Isla Care
TEAMS_CHANNEL_NAME=Smart Queue Notifications
# Supply the generated callback only in the ignored backend/.env file.
TEAMS_WEBHOOK_URL=
TEAMS_NOTIFICATION_EVENTS=appointment.cancelled,appointment.reassigned,ana.workflow.completed,ana.workflow.failed
TEAMS_NOTIFICATION_MODE=demo
# Optional HTTPS link shown in notification cards; omit for this public POC.
TEAMS_DASHBOARD_URL=
TEAMS_REQUEST_TIMEOUT_SECONDS=3
