{
  "name": "smart-queue-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run copy:presentation",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:demo": "tsc -b && vite build --mode public-demo && npm run copy:presentation && npm run verify:demo",
    "copy:presentation": "node scripts/copy-presentation.mjs dist",
    "verify:demo": "node scripts/verify-demo.mjs dist",
    "package:vercel": "node scripts/package-vercel.mjs",
    "lint": "biome lint . --error-on-warnings",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
